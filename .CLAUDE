│       └── store-listings/     # Store submission materials
├── tmp/                         # Temporary files (gitignored)
│   ├── docs/                   # Working documentation
│   └── scripts/                # One-time scripts
├── .claude/                     # Claude AI workspace
│   ├── skills/                 # Claude skills for development
│   │   ├── parser-generator/   # Parser generation skill
